<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    android:layout_marginBottom="-20dp"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#DDDDDD"
        android:layout_marginBottom="16dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/sheet_ilan_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedAppearance"
            android:src="@drawable/placeholder_ilan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/sheet_ilan_image"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheet_ilan_baslik"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ürün Başlığı"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/sheet_ilan_fiyat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.500 TL"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/sheet_ilan_mesafe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="200m yakınınızda"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </RelativeLayout>

    <Button
        android:id="@+id/btn_detay_git"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="İlanı İncele &amp; Sohbet Et"
        android:backgroundTint="@color/primary"
        android:textAllCaps="false"
        app:cornerRadius="12dp" />

</LinearLayout>
</com.google.android.material.card.MaterialCardView>